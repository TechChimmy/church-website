// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Auth ─────────────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(ADMIN)
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum Role {
  ADMIN
  SUPER_ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

// ── Hero Slides ───────────────────────────────────────
model HeroSlide {
  id        String   @id @default(cuid())
  title     String
  subtitle  String
  ctaText   String
  ctaHref   String
  imageUrl  String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Site Settings (key-value store) ──────────────────
model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  label     String
  group     String   @default("general")
  type      String   @default("text")
  updatedAt DateTime @updatedAt
}

// ── Events — SINGLE SOURCE OF TRUTH ──────────────────
// Both Admin > Events and all frontend calendars use this table.
// CalendarEvent table kept for backward compat but no longer the
// primary source for homepage/events-page display.
model Event {
  id           String    @id @default(cuid())
  title        String
  description  String    @db.Text
  date         DateTime
  endDate      DateTime?
  time         String?
  location     String?
  imageUrl     String?
  featured     Boolean   @default(false)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  participations EventParticipation[]

  @@index([date])
  @@index([active])
}

model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  date        DateTime
  time        String?
  endTime     String?
  color       String   @default("#c9a84c")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
}

// ── Event Participations ──────────────────────────────
model EventParticipation {
  id         String   @id @default(cuid())
  eventId    String
  eventTitle String
  name       String
  email      String
  phone      String?
  createdAt  DateTime @default(now())

  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// ── Ask Collins ───────────────────────────────────────
model CollinsQuestion {
  id          String         @id @default(cuid())
  name        String
  email       String?
  question    String         @db.Text
  answer      String?        @db.Text
  answerTitle String?
  imageUrl    String?
  status      QuestionStatus @default(PENDING)
  consent     Boolean        @default(false)
  read        Boolean        @default(false)
  archived    Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status])
  @@index([read])
  @@index([archived])
}

enum QuestionStatus {
  PENDING
  APPROVED
  REJECTED
  PUBLISHED
}

// ── Testimonials ──────────────────────────────────────
model Testimonial {
  id        String   @id @default(cuid())
  name      String
  body      String   @db.Text
  imageUrl  String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Service Times ─────────────────────────────────────
model ServiceTime {
  id        String   @id @default(cuid())
  title     String
  day       String
  time      String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Media Library ─────────────────────────────────────
model MediaItem {
  id        String   @id @default(cuid())
  filename  String
  url       String
  publicId  String
  width     Int?
  height    Int?
  size      Int?
  mimeType  String?
  folder    String   @default("general")
  createdAt DateTime @default(now())
}

// ── Prayer Requests ───────────────────────────────────
model PrayerRequest {
  id            String   @id @default(cuid())
  name          String?
  email         String?
  prayerRequest String   @db.Text
  anonymous     Boolean  @default(false)
  read          Boolean  @default(false)
  archived      Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([read])
  @@index([archived])
}

// ── Contact Messages ──────────────────────────────────
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String   @db.Text
  read      Boolean  @default(false)
  archived  Boolean  @default(false)
  replied   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read])
  @@index([archived])
}
