# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"


# Sanity CMS Connection
SANITY_PROJECT_ID="your-sanity-project-id"
SANITY_DATASET="production"
SANITY_API_VERSION="2024-01-01"
SANITY_API_WRITE_TOKEN="your-sanity-api-write-token"

# YouTube (optional - for live streaming)
YOUTUBE_API_KEY="your-youtube-api-key"
YOUTUBE_CHANNEL_ID="your-channel-id"

# Telegram Bot (for form submissions)
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_GROUP_CHAT_ID="your-telegram-chat-id"

# Custom Admin Login Defaults
ADMIN_DEFAULT_EMAIL="your-secure-email-here"
ADMIN_DEFAULT_PASSWORD="your-secure-password-here"
